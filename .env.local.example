# 이 파일은 커밋된다. 실제 키를 여기에 적지 말 것.
# 복사해서 `.env.local` 을 만들고 거기에 값을 채운다 (.env*.local 은 gitignore 대상).

NEXT_PUBLIC_SUPABASE_URL=https://hryikreaxngexhjjxfyl.supabase.co

# Supabase 대시보드 > Project Settings > API Keys
# publishable key (sb_publishable_...) — 브라우저에 노출되어도 되는 키. RLS 가 방어선이다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# secret key (sb_secret_...) — RLS 를 우회한다. 서버 전용. 절대 클라이언트로 보내지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# 넥슨 오픈 API 키 — https://openapi.nexon.com > 내 애플리케이션 에서 발급.
# `pnpm probe` (scripts/nexon-probe) 가 실측 탐침에 사용한다. 절대 커밋하지 말 것.
# ⚠️ **앱 로그인은 이 값을 쓰지 않는다.** 로그인은 사용자가 화면에서 입력한 키를 쓰며,
#    서버는 그 키의 SHA-256 해시만 저장한다(CLAUDE.md §2.1.1).
NEXON_API_KEY=

# 사용자 넥슨 API 키를 DB 에 보관할 때 쓰는 마스터키 — 서버 전용. AES-256-GCM.
# base64(url) 로 인코딩된 **정확히 32바이트**여야 한다.
# 이 값이 없으면 로그인 · 키 추가가 즉시 실패한다. 조용히 평문으로 저장하는 폴백은 없다.
# 값을 잃어버리면 보관된 키를 복호화할 수 없고, 사용자가 키를 다시 입력해야 한다.
# 생성:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
API_KEY_ENCRYPTION_KEY=

# 세션 쿠키 서명 키 — 서버 전용. 이 값이 없으면 로그인 자체가 동작하지 않는다.
# 32자 이상이어야 하며, 값을 바꾸면 **모든 세션이 즉시 무효**가 된다(전역 킬 스위치).
# 생성:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ⚠️ BOT_SIGNING_SECRET 은 2026-09-28 에 **쓰이지 않게 됐다.** 방(채널) 개념이 사라지면서
#    채널마다 시크릿을 파생할 대상이 없어졌고, 코드에 참조가 한 건도 남아 있지 않다.
#    새로 배포한다면 채우지 말 것 — 아래 BOT_RUNNER_TOKEN 하나면 된다.

# 카톡 런너 설치 토큰 — **서버 전용**. 32자 이상.
# 2026-09-28 에 방(채널) 개념이 사라지면서 채널마다 파생하던 시크릿을 대체한다.
# 런너 스크립트(scripts/OpenchatbotR.js)의 CONFIG.RUNNER_TOKEN 과
# **한 글자도 달라선 안 된다.** 모든 /api/bot/command 요청의 HMAC 서명 키이고,
# 이 값을 바꾸면 런너가 한 번에 전부 무효가 된다(전역 킬 스위치).
# 생성:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BOT_RUNNER_TOKEN=

# 화면에 보이는 개발 도구(목 계측 표시, 조회 실패 주입 토글)를 켠다.
# `1` 일 때만 켜지는 명시적 옵트인이며, **프로덕션 배포에서는 설정하지 않는다.**
# NODE_ENV 로 가르지 않는 이유는 src/lib/env-flags.ts 주석 참고
# (NODE_ENV 는 빌드 시점에 번들로 굳어서, 빌드 환경이 오염되면 되돌릴 수 없다).
NEXT_PUBLIC_DEV_TOOLS=1

# ─────────────────────────────────────────────────────────────────────────────
# 예약 동기화 (매일 23:50 KST = 14:50 UTC · vercel.json 의 crons)
# ─────────────────────────────────────────────────────────────────────────────
# `/api/cron/sync` 를 부를 수 있는 유일한 열쇠다. Vercel 크론이
# `Authorization: Bearer $CRON_SECRET` 을 자동으로 붙여 준다.
#
# ⚠️ **비어 있으면 아무도 못 부른다.** 그 라우트는 세션 없이 저장된 사용자 키로 넥슨을
#    부르므로, 설정 누락은 열리는 쪽이 아니라 잠기는 쪽으로 실패해야 한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
